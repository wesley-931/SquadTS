{
  "name": "squadts",
  "version": "1.0.0",
  "description": "SquadTS - TypeScript variant of the SquadJS framework for Squad server scripting and automation",
  "repository": "https://github.com/wesley-931/SquadTS.git",
  "author": "Thomas Smyth <https://github.com/Thomas-Smyth>",
  "license": "BSL-1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/index.js",
    "lint": "eslint \"src/**/*.ts\" && prettier --check \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix && prettier --write \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "build-config": "tsx src/squad-server/scripts/build-config-file.ts",
    "build-readme": "tsx src/squad-server/scripts/build-readme.ts",
    "build-all": "tsx src/squad-server/scripts/build-config-file.ts && tsx src/squad-server/scripts/build-readme.ts"
  },
  "dependencies": {
    "async": "^3.2.6",
    "axios": "^1.7.9",
    "basic-ftp": "^5.0.5",
    "chalk": "^4.1.2",
    "didyoumean": "^1.2.2",
    "discord.js": "^14.18.0",
    "ftp-tail": "^2.1.1",
    "gamedig": "^5.3.3",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "mariadb": "^3.4.0",
    "moment": "^2.30.1",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7",
    "tail": "^2.2.6",
    "tedious": "^19.0.0",
    "tinygradient": "^1.1.5"
  },
  "devDependencies": {
    "@types/async": "^3.2.24",
    "@types/didyoumean": "^1.2.3",
    "@types/node": "^22.13.0",
    "@types/tail": "^2.2.3",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
